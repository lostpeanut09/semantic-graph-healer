{
  "name": "semantic-graph-healer",
  "version": "1.0.0",
  "description": "Diagnoses and repairs structural problems in large Obsidian knowledge graphs",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint .",
    "knip": "knip --production",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "version:check": "node -e \"const v=require('./manifest.json').version;console.log('manifest',v);\""
  },
  "keywords": [],
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/web-worker": "^5.0.5",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@ladybugdb/wasm-core": "0.21.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "3d-force-graph": "^1.80.1",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^17.6.0",
    "graphology": "^0.26.0",
    "graphology-metrics": "^2.4.2",
    "jiti": "^2.6.1",
    "jsdom": "^30.1.3",
    "knip": "^6.43.0",
    "lint-staged": "^17.6.0",
    "obsidian": "1.14.4",
    "obsidian-test-mocks": "^7.3.0",
    "obsidian-typings": "^6.50.0",
    "pathe": "^2.0.3",
    "p-queue": "^10.0.0",
    "prettier": "^3.9.10",
    "svelte": "^5.57.2",
    "three": "^0.186.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
