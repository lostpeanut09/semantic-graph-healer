{
    "name": "semantic-graph-healer",
    "version": "3.0.0",
    "type": "module",
    "description": "Topological restoration engine that utilizes Dataview, Breadcrumbs, and ExcaliBrain metadata to identify and resolve structural inconsistencies in the knowledge graph.",
    "engines": {
        "node": ">=24.0.0",
        "npm": ">=11.0.0"
    },
    "main": "main.js",
    "scripts": {
        "dev": "node .config/esbuild.config.mjs",
        "build": "tsc --noEmit --skipLibCheck && node .config/esbuild.config.mjs production",
        "lint": "eslint -c .config/eslint.config.js .",
        "lint:css": "stylelint \"**/*.css\" --config .config/.stylelintrc.json",
        "lint:yaml": "yamllint-js .",
        "format": "prettier --config .config/.prettierrc --ignore-path .config/.prettierignore --write .",
        "knip": "knip -c .config/knip.json",
        "check-version": "tsx scripts/check-version.ts",
        "prepare": "husky",
        "nano-staged": "nano-staged",
        "lint:fix": "eslint -c .config/eslint.config.js . --fix && stylelint \"**/*.css\" --config .config/.stylelintrc.json --fix",
        "test": "cross-env NODE_OPTIONS='--no-warnings' vitest run",
        "test:adapter": "vitest run tests/core/adapters/DatacoreAdapter.test.ts",
        "test:breadcrumbs": "vitest run tests/core/adapters/BreadcrumbsAdapter.test.ts",
        "test:worker": "vitest run tests/core/workers/GraphAnalysisWorkerCore.test.ts",
        "bench:generate": "tsx scripts/generate-mock-vault.ts",
        "bench:run": "tsx tests/benchmarks/PerformanceBenchmark.test.ts",
        "postinstall": "husky"
    },
    "keywords": [],
    "author": "lostpeanut09",
    "license": "GPL-3.0",
    "devDependencies": {
        "@eslint/js": "^9.10.0",
        "@eslint/json": "^0.14.0",
        "@faker-js/faker": "^10.4.0",
        "@sveltejs/vite-plugin-svelte": "^7.1.2",
        "@types/benchmark": "^2.1.5",
        "@types/node": "^24.12.4",
        "@typescript-eslint/eslint-plugin": "^8.57.2",
        "@typescript-eslint/parser": "^8.57.2",
        "@vitest/ui": "^4.1.0",
        "@vitest/web-worker": "^4.1.4",
        "benchmark": "^2.1.4",
        "cross-env": "^10.1.0",
        "esbuild": "^0.28.0",
        "esbuild-svelte": "^0.9.5",
        "eslint": "^10.1.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-obsidianmd": "^0.1.9",
        "graphology-types": "^0.24.8",
        "husky": "^9.1.7",
        "jsdom": "^29.0.2",
        "knip": "^6.0.5",
        "nano-staged": "^0.8.0",
        "obsidian": "latest",
        "obsidian-typings": "^5.18.0",
        "p-queue": "^9.1.2",
        "prettier": "^3.8.1",
        "stylelint": "^17.5.0",
        "stylelint-config-standard": "^40.0.0",
        "svelte-preprocess": "^6.0.3",
        "tslib": "^2.4.0",
        "tsx": "^4.21.0",
        "typescript": "^5.0.0",
        "typescript-eslint": "^8.57.2",
        "vite": "^8.0.11",
        "vitest": "^4.1.6",
        "yamllint-js": "^0.2.4"
    },
    "dependencies": {
        "@ladybugdb/wasm-core": "^0.16.1",
        "3d-force-graph": "^1.80.0",
        "d3-force-3d": "^3.0.6",
        "graphology": "^0.26.0",
        "graphology-communities-louvain": "^2.0.2",
        "graphology-metrics": "^2.4.0",
        "pathe": "^2.0.3",
        "svelte": "^5.55.5",
        "three": "^0.184.0",
        "zod": "^4.3.6"
    },
    "nano-staged": {
        "*.ts": [
            "eslint -c .config/eslint.config.js --fix",
            "prettier --config .config/.prettierrc --ignore-path .config/.prettierignore --write"
        ],
        "*.css": [
            "stylelint --config .config/.stylelintrc.json --fix",
            "prettier --config .config/.prettierrc --ignore-path .config/.prettierignore --write"
        ],
        "*.{json,md}": [
            "prettier --config .config/.prettierrc --ignore-path .config/.prettierignore --write"
        ],
        "**/*.yml": [
            "yamllint-js"
        ]
    }
}
