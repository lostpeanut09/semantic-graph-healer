echo "??? Building project..."
npm run build
if [ $? -ne 0 ]; then
  echo "? Build failed"
  exit 1
fi

echo "?? Running lint check..."
npm run lint
if [ $? -ne 0 ]; then
  echo "? Lint failed — fix warnings before pushing (lint:fix recommended)"
  exit 1
fi

echo "?? Running tests..."
npm test
if [ $? -ne 0 ]; then
  echo "? Tests failed"
  exit 1
fi

echo "? Pre-push checks passed"
