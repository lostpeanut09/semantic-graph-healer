{
    "$schema": "https://unpkg.com/knip@5/schema.json",
    "project": ["**/*.ts"],
    "entry": ["src/main.ts", "src/core/workers/graph-analysis-worker.ts", "tests/**/*.test.ts"],
    "ignore": ["vitest.setup.ts"],
    "ignoreDependencies": [
        "stylelint-config-standard",
        "@typescript-eslint/eslint-plugin",
        "@typescript-eslint/parser",
        "d3-force-3d",
        "three",
        "@types/benchmark",
        "benchmark"
    ],
    "rules": {
        "files": "error",
        "dependencies": "error",
        "unlisted": "error",
        "exports": "error",
        "types": "error"
    }
}
